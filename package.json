{
  "name": "ejara-txman",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "dev:backend": "bun run --filter @ejara/txman-backend start:dev",
    "dev:frontend": "bun run --filter @ejara/txman-frontend dev",
    "start:backend": "bun run --filter @ejara/txman-backend start:prod",
    "start:frontend": "bun run --filter @ejara/txman-frontend start",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0"
  }
}
